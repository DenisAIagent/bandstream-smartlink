# =============================================================================
# band.stream — Environment variables (example)
# Copy to `.env` and fill in real values. Never commit `.env`.
# Variable names below match what the code actually reads (grep process.env.*).
# =============================================================================

# --- Core ---------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/bandstream
AUTH_SECRET=                         # random string, e.g. `openssl rand -base64 32`
ROOT_DOMAIN=band.stream
ROOT_DOMAIN_URL=https://band.stream
# NODE_ENV is set by the runtime (development | production)
# BUILD_ID=development                # optional custom build id
# PORT=3000                           # optional, default 3000

# --- Auth (Google OAuth) ------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object storage (S3-compatible: Scaleway / MinIO) -------------------------
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=bands
S3_PUBLIC_URL=https://bands.s3.fr-par.scw.cloud
# SCALEWAY_ENDPOINT is also read as a fallback for the image remotePattern host
SCALEWAY_ENDPOINT=https://s3.fr-par.scw.cloud

# --- Transactional email ------------------------------------------------------
RESEND_API_KEY=
# BREVO_API_KEY=                      # alternative email provider (read by the code)
INTERNAL_API_TOKEN=                  # protects the internal welcome-mail endpoint

# --- Slack notifications ------------------------------------------------------
SLACK_WEBHOOK_URL_USERS=             # #users-and-customers sign-in/up events

# --- i18n translation script (scripts/translate.js) ---------------------------
OPENAI_API_KEY=                      # required only to run `npm run translate`

# =============================================================================
# Update V1.1 — new variables added with smartlinks / plans / analytics
# =============================================================================

# --- Stripe (subscriptions: Free / Pro; Label is activated manually) ----------
STRIPE_API_KEY=                      # sk_live_... (or sk_test_... locally)
STRIPE_PRICE_ID_PRO=                 # price_... for the €5/mo Pro plan
STRIPE_WEBHOOK_SECRET=               # whsec_... for the Stripe webhook

# --- Umami analytics (one website per artist, per-smartlink stats) ------------
# Self-hosted auth: endpoint + user id + secret …
UMAMI_API_CLIENT_ENDPOINT=https://umami.example.com/api
UMAMI_API_CLIENT_USER_ID=
UMAMI_API_CLIENT_SECRET=
# … or Umami Cloud:
# UMAMI_API_KEY=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.example.com/script.js

# --- Merch shop add-on (bandstream-shop SSO bridge) ----------------------------
# The main app is the source of truth for the Shop add-on (Subscription.shopAddon).
# SHOP_SSO_SECRET must be IDENTICAL in bandstream-shop's env.
SHOP_PUBLIC_URL=https://shop.band.stream
SHOP_SSO_SECRET=                     # e.g. `openssl rand -base64 32`

# --- Internal CRM SSO bridge (Logiciels internes/bandstream-crm) ---------------
# Team-only (OWNER/ADMIN). CRM_PUBLIC_URL must be the origin that serves the
# CRM front (/api/v1 is reverse-proxied to its API). CRM_SSO_SECRET must be
# IDENTICAL to BANDSTREAM_SSO_SECRET in the CRM env.
CRM_PUBLIC_URL=https://crm.band.stream
CRM_SSO_SECRET=                      # e.g. `openssl rand -base64 32`
# Data sync app ↔ CRM: CRM_API_URL = the CRM API origin (server-to-server,
# signup/plan webhooks). CRM_API_KEY = the Bearer key the CRM uses to call
# our /api/crm/v1/* platform API (configured in the CRM /settings page).
CRM_API_URL=https://crm-api.band.stream
CRM_API_KEY=                         # e.g. `openssl rand -hex 24`

# --- Local preview only — NEVER set in production -----------------------------
# Forges an OWNER session when there is no login. Force-disabled when
# NODE_ENV=production (see auth.ts), but do not ship it.
# PREVIEW_NO_AUTH=1
